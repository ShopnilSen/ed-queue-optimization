# Copy to .env (never commit it) and fill in only the providers you use.
# AutoResearch reads provider keys from environment variables named in
# `.autoresearch/config.toml`; it does not parse this file automatically.
# Export the values in your shell, or use a process manager that loads .env.

# LLM providers
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# A generic variable if you point `api_key_env` at your own gateway.
AUTORESEARCH_LLM_API_KEY=

# Optional: Semantic Scholar API key (higher rate limits).
SEMANTIC_SCHOLAR_API_KEY=

# Optional: contact email for the OpenAlex / Crossref polite pools.
OPENALEX_MAILTO=
CROSSREF_MAILTO=
